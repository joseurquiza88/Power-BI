            "sortByColumn": "NroMes",
            "sourceColumn": "Mes",
            "summarizeBy": "none"
          },
          {
            "name": "Mes-Anio",
            "dataType": "string",
            "lineageTag": "85636564-ec02-4a75-b14b-cad2f393b1b6",
            "sortByColumn": "NroMes",
            "sourceColumn": "Mes-Anio",
            "summarizeBy": "none"
          },
          {
            "name": "Trimestre",
            "dataType": "string",
            "lineageTag": "7f6c25e0-0382-4dc6-b783-f7fabc4ef86b",
            "sourceColumn": "Trimestre",
            "summarizeBy": "none"
          },
          {
            "name": "DiaSemana",
            "dataType": "string",
            "lineageTag": "f2f5a702-4c63-4fad-a785-ee186b489d7b",
            "sourceColumn": "DiaSemana",
            "summarizeBy": "none"
          }
        ],
        "dataCategory": "Time",
        "lineageTag": "308cefd4-1d9f-4405-9625-48d25d6c6f8e",
        "partitions": [
          {
            "name": "Calendario",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    FechaInicio = #date(2025, 1, 1),",
                "    FechaFin = #date(2025, 12, 31),",
                "    TotalDias = Duration.Days(FechaFin - FechaInicio) + 1,",
                "    ListaFechas = List.Dates(FechaInicio, TotalDias, #duration(1, 0, 0, 0)),",
                "    Tabla = Table.FromList(ListaFechas, Splitter.SplitByNothing(), {\"Fecha\"}, null, ExtraValues.Error),",
                "    TipoFecha = Table.TransformColumnTypes(Tabla,{{\"Fecha\", type date}}),",
                "    ColAnio = Table.AddColumn(TipoFecha, \"Anio\", each Date.Year([Fecha]), Int64.Type),",
                "    ColNroMes = Table.AddColumn(ColAnio, \"NroMes\", each Date.Month([Fecha]), Int64.Type),",
                "    ColMes = Table.AddColumn(ColNroMes, \"Mes\", each Date.ToText([Fecha], \"MMMM\", \"es-ES\"), type text),",
                "    ColMesAnio = Table.AddColumn(ColMes, \"Mes-Anio\", each Date.ToText([Fecha], \"MMM-yyyy\", \"es-ES\"), type text),",
                "    ColTrimestre = Table.AddColumn(ColMesAnio, \"Trimestre\", each \"T\" & Text.From(Date.QuarterOfYear([Fecha])), type text),",
                "    ColDiaSemana = Table.AddColumn(ColTrimestre, \"DiaSemana\", each Date.ToText([Fecha], \"dddd\", \"es-ES\"), type text)",
                "in",
                "    ColDiaSemana"
              ],
              "type": "m"
            }
          }
        ]
      },
      {
        "name": "_Medidas",
        "columns": [
          {
            "name": "ColumnaDummy",
            "dataType": "string",
            "isHidden": true,
            "lineageTag": "fe542655-90dd-4a52-81a9-495a048396ba",
            "sourceColumn": "ColumnaDummy",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "d75f624f-6675-4ec1-8c7b-d2f8d053c03a",
        "measures": [
          {
            "name": "Ventas Brutas",
            "displayFolder": "Ventas",
            "expression": "SUMX(detalle_pedidos, detalle_pedidos[cantidad] * detalle_pedidos[precio_unitario])",
            "formatString": "$#,##0.00;($#,##0.00);$#,##0.00",
            "lineageTag": "3854f4df-ef40-4be3-9ae3-0ca61a5239c8"
          },
          {
            "name": "Ventas Netas",
            "displayFolder": "Ventas",
            "expression": "SUMX(detalle_pedidos, detalle_pedidos[cantidad] * detalle_pedidos[precio_unitario] * (1 - detalle_pedidos[descuento]))",
            "formatString": "$#,##0.00;($#,##0.00);$#,##0.00",
            "lineageTag": "e3bac4ad-2f1e-4167-b647-d0e558d5ea67"
          },
          {
            "name": "Cantidad Pedidos",
            "displayFolder": "Volumen",
            "expression": "DISTINCTCOUNT(pedidos[id_pedido])",
            "formatString": "#,##0",
            "lineageTag": "d84a8bb8-4bb3-4b49-b209-58bca3fb9e18"
          },
          {
            "name": "Unidades Vendidas",
            "displayFolder": "Volumen",
            "expression": "SUM(detalle_pedidos[cantidad])",
            "formatString": "#,##0",
            "lineageTag": "b9bf94d5-358b-4442-a855-f281fdeec49f"
          },
          {
            "name": "Ticket Promedio",
            "displayFolder": "Ventas",
            "expression": "DIVIDE([Ventas Netas], [Cantidad Pedidos], 0)",
            "formatString": "$#,##0.00;($#,##0.00);$#,##0.00",
            "lineageTag": "90cfa94f-75f7-4acd-a440-1c0308fd8ba6"
          },
          {
            "name": "Costo de Productos Vendidos",
            "displayFolder": "Costos y Margen",
            "expression": "SUMX(detalle_pedidos, detalle_pedidos[cantidad] * RELATED(productos[costo]))",
            "formatString": "$#,##0.00;($#,##0.00);$#,##0.00",
            "lineageTag": "39711cbd-64ec-4cd2-aaa4-50f51dc8af4a"
          },
          {
            "name": "Margen Bruto",
            "displayFolder": "Costos y Margen",
            "expression": "[Ventas Netas] - [Costo de Productos Vendidos]",
            "formatString": "$#,##0.00;($#,##0.00);$#,##0.00",
            "lineageTag": "a5bd9cd1-a2b2-44ea-af6e-a830a3de4d92"
          },
          {
            "name": "Porcentaje de Margen",
            "displayFolder": "Costos y Margen",
            "expression": "DIVIDE([Margen Bruto], [Ventas Netas], 0)",
            "formatString": "0.00%",
            "lineageTag": "baa42b0a-48fa-4431-8b01-25a1af561ec6"
          }
        ],
        "partitions": [
          {
            "name": "_Medidas",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Origen = #table({\"ColumnaDummy\"}, {{\"_\"}})",
                "in",
                "    Origen"
              ],
              "type": "m"
            }
          }
        ]
      }
    ]
  }
